# commercetools API client credentials
# Create an API client in Merchant Center > Settings > Developer settings
# API client needs at least: view_orders (covers carts and orders) and view_customers. Read-only is enough.
CT_PROJECT_KEY=
CT_CLIENT_ID=
CT_CLIENT_SECRET=

# Base URLs for your commercetools region (no trailing slash)
# e.g. https://auth.australia-southeast1.gcp.commercetools.com
CT_AUTH_URL=
# e.g. https://api.australia-southeast1.gcp.commercetools.com
CT_API_URL=

# Metric to run. One of:
#   CART_TOTAL | ANONYMOUS_CART | LOGGED_IN_CART | FIRST_TIME_BUYERS
#   LOGGED_IN_ORDERS | ANONYMOUS_ORDERS | REPEATED_ORDERS | TOTAL_ORDERS | TOTAL_CUSTOMERS
MODE=CART_TOTAL
